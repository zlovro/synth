 170:Core/Src/main.c **** 
 171:Core/Src/main.c ****     gpioModeOutput(&gMuxMasterCfg.pinSig);
 172:Core/Src/main.c ****     gpioSet(&gMuxMasterCfg.pinSig, pVal);
 173:Core/Src/main.c **** }
