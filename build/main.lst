 102:Core/Src/main.c **** void delayUs(TIM_TypeDef* pTim, volatile s32 pUs)
 103:Core/Src/main.c **** {
 104:Core/Src/main.c ****     if (pUs <= 0)
 105:Core/Src/main.c ****     {
 106:Core/Src/main.c ****         return;
 107:Core/Src/main.c ****     }
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****     volatile u32 lim = pUs / 10;
 110:Core/Src/main.c ****     volatile int i   = 0;
 111:Core/Src/main.c ****     pTim->CNT        = 0;
 112:Core/Src/main.c ****     while (pTim->CNT < lim)
 113:Core/Src/main.c ****     {
 114:Core/Src/main.c ****         i++;
 115:Core/Src/main.c ****     }
 116:Core/Src/main.c **** }
