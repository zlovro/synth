 107:Core/Src/main.c **** void delayUs(TIM_TypeDef *pTim, volatile s32 pUs) {
 108:Core/Src/main.c ****     if (pUs <= 0)
 109:Core/Src/main.c ****     {
 110:Core/Src/main.c ****         return;
 111:Core/Src/main.c ****     }
 112:Core/Src/main.c **** 
 113:Core/Src/main.c ****     volatile int i = 0;
 114:Core/Src/main.c ****     pTim->CNT      = 0;
 115:Core/Src/main.c ****     while (pTim->CNT < pUs)
 116:Core/Src/main.c ****     {
 117:Core/Src/main.c ****         i++;
 118:Core/Src/main.c ****     }
 119:Core/Src/main.c **** }
