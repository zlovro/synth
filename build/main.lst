 157:Core/Src/main.c **** // 14 GPIO ops = 8 + 4 + 1 + 1
 158:Core/Src/main.c **** void muxWrite(mux *pMux, u8 pChan, bool pVal) {
 159:Core/Src/main.c ****     for (int i = 0; i < gMuxCount; ++i)
 160:Core/Src/main.c ****     {
 161:Core/Src/main.c ****         gpioSet(&((gMuxList + i)->enable), 1);
 162:Core/Src/main.c ****     }
 163:Core/Src/main.c **** 
